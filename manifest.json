{
  "manifest_version": 3,
  "name": "Hacker News Summary",
  "version": "0.5.0",
  "minimum_chrome_version": "121",
  "description": "Summaries of Hacker News links, without leaving HN. On-device if your browser can, or OpenRouter (article text goes to OpenRouter).",
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": {
    "scripts": ["src/background.js"],
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://news.ycombinator.com/*"],
      "js": ["src/vendor/defuddle.js", "src/lib/markdown.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "declarativeNetRequest"],
  "host_permissions": ["https://news.ycombinator.com/*", "https://openrouter.ai/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
